{
  "name": "dh-lottery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:worker\" \"npm run dev:app\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:app": "vite",
    "build": "npm run build:app && npm run build:worker",
    "build:app": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --outfile=dist-worker/index.js",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wrangler": "^3.91.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
